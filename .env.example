# Postgres connection string. Lokálně odpovídá docker-compose.yml
# (`docker compose up -d postgres`).
DATABASE_URL=postgres://cestice:cestice@127.0.0.1:5432/cestice

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google reCAPTCHA v3 — ochrana formulářů proti spamu.
# Klíče se zakládají na https://www.google.com/recaptcha/admin (typ v3),
# domény: localhost + produkční doména.
# Bez nich se ověření mimo produkci přeskakuje.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# ── E-maily ───────────────────────────────────────────────────────────────
# Adapter se vybírá podle toho, co je vyplněné (src/email/adapter.ts):
#   RESEND_API_KEY  → Resend
#   SMTP_HOST       → SMTP
#   nic z toho      → mail se jen vypíše do logu (dev), v produkci je to chyba
#
# Odesílatel. U Resendu MUSÍ být na ověřené doméně (SPF + DKIM) — klubová
# adresa na seznam.cz tam neprojde. Bez vyplnění se použije hccestice@seznam.cz.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Kam chodí notifikace o formulářích, když si adresáta neurčí formulář v adminu.
EMAIL_NOTIFICATION_ADDRESS=
# Testovací režim: přesměruje VŠECHNY odchozí maily na jednu adresu.
EMAIL_OVERRIDE_RECIPIENT=

# Produkce (varianta Resend) — https://resend.com/api-keys
RESEND_API_KEY=

# Dev / varianta SMTP. `SMTP_SECURE` je volitelné, jinak se odvodí z portu
# (465 = implicitní TLS, 587 = STARTTLS). Bez `SMTP_USER` se pošta posílá
# bez autentizace (lokální relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# ── Sentry (monitoring chyb) ───────────────────────────────────────────────
# DSN je `NEXT_PUBLIC_*`, takže se zapéká do klientského bundlu při buildu —
# viz sekce Nasazení v AGENTS.md. Bez něj `Sentry.init` jen zaloguje varování
# a nic se neodesílá (funguje bez účtu na Sentry i lokálně).
# Projekt/DSN: https://sentry.io/ → Settings → Projects → (projekt) → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=

# Jen pro build — upload source map, aby stack trace v Sentry ukazoval na
# původní TS/TSX, ne na minifikovaný bundle. Bez nich build proběhne dál,
# jen bez čitelných stack trace.
# Token: https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Google Analytics (GA4) ─────────────────────────────────────────────────
# Měřicí ID je `NEXT_PUBLIC_*`, zapéká se do bundlu při buildu. Bez něj se
# GA skript vůbec nevykreslí — lokální vývoj a preview buildy proto default
# neznečišťují produkční data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
